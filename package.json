{
  "name": "crows-eye",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local dashboard that groups the GitHub pull requests needing your attention into configurable sections.",
  "keywords": [
    "github",
    "pull-requests",
    "dashboard",
    "code-review",
    "cli"
  ],
  "author": "Tyler Hunt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylershunt/crows-eye.git"
  },
  "bugs": {
    "url": "https://github.com/tylershunt/crows-eye/issues"
  },
  "homepage": "https://github.com/tylershunt/crows-eye#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
